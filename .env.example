# PARENTIQ Platform Environment Variables Configuration
# Copy this file to .env before starting services

# Application Metadata
PROJECT_NAME="PARENTIQ - Child Safety & Parental Control Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Cryptographic Keys (Generate with `openssl rand -hex 32`)
SECRET_KEY="parentiq_development_secret_key_change_in_production_min_32_bytes_long"
REFRESH_SECRET_KEY="parentiq_development_refresh_secret_key_change_in_production_32_bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Pairing Security Settings
PAIRING_CODE_EXPIRE_MINUTES=15
PAIRING_MAX_ATTEMPTS=5

# Database Configuration
# In production, use PostgreSQL: postgresql+psycopg2://parentiq_admin:password@localhost:5432/parentiq
DATABASE_URL="sqlite:///./backend/parentiq.db"

# Redis Cache & WebSockets PubSub
REDIS_URL="redis://localhost:6379/0"

# Firebase Cloud Messaging Credentials
FIREBASE_CREDENTIALS_PATH=""

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000","*"]


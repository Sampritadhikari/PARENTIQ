# PARENTIQ Backend Environment Configuration Example
PROJECT_NAME="PARENTIQ - Child Safety & Parental Control"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Cryptographic Keys (Use high-entropy secrets in production: openssl rand -hex 32)
SECRET_KEY="parentiq_development_secret_key_change_in_production_min_32_bytes_long"
REFRESH_SECRET_KEY="parentiq_development_refresh_secret_key_change_in_production_32_bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Pairing Security
PAIRING_CODE_EXPIRE_MINUTES=15
PAIRING_MAX_ATTEMPTS=5

# Database Configuration (PostgreSQL in production; SQLite fallback supported in dev/tests)
DATABASE_URL="sqlite:///./parentiq.db"
# Example PostgreSQL: postgresql://parentiq_user:secure_password@localhost:5432/parentiq_db

# Redis Caching & Realtime PubSub (Optional in local dev fallback)
REDIS_URL="redis://localhost:6379/0"

# Firebase Cloud Messaging & Admin (Optional mock fallback if absent)
FIREBASE_CREDENTIALS_PATH=""

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000","*"]

